generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  name         String?
  email        String           @unique
  passwordHash String
  image        String?
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum JobType {
  FULL_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
}

enum JobStatus {
  WISHLIST
  APPLIED
  ASSESSMENT
  HR_INTERVIEW
  TECH_INTERVIEW
  OFFER
  ACCEPTED
  REJECTED
  GHOSTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

model JobApplication {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        String
  role           String
  jobUrl         String?
  location       String?
  workMode       WorkMode  @default(ONSITE)
  jobType        JobType   @default(FULL_TIME)
  status         JobStatus @default(WISHLIST)
  priority       Priority  @default(MEDIUM)
  salaryMin      Int?
  salaryMax      Int?
  expectedSalary Int?
  realSalary     Int?
  currency       String    @default("IDR")
  platform       String?
  requirements   String[]
  description    String?
  notes          String?
  recruiterInfo  String?
  resumeUsed     String?
  appliedDate    DateTime  @default(now())
  followUpDate   DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([userId])
}
